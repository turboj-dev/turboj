<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.turboj.fixtures</groupId><artifactId>cherry-native</artifactId><version>1.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <testit.buildDirectory>${project.basedir}/target</testit.buildDirectory>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
    <dependency><groupId>com.cherrytest</groupId><artifactId>cherry-test-junit</artifactId><version>0.3.16</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${testit.buildDirectory}</directory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version>
        <configuration><testFailureIgnore>true</testFailureIgnore></configuration>
      </plugin>
      <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.15</version>
        <executions><execution><goals><goal>prepare-agent</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>cherry-provenance</id>
      <activation><property><name>env.CHERRY_TEST_PROVENANCE_TOKEN</name></property></activation>
      <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
          <executions><execution><id>default-compile</id><configuration>
            <annotationProcessorPaths><path><groupId>com.cherrytest</groupId><artifactId>cherry-test-provenance</artifactId><version>0.3.16</version></path></annotationProcessorPaths>
            <compilerArgs><arg>-Xplugin:CherryProvenance ${project.build.outputDirectory}</arg></compilerArgs>
          </configuration></execution></executions>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
          <configuration><argLine>@{argLine} "-javaagent:${settings.localRepository}/com/cherrytest/cherry-test-provenance/0.3.16/cherry-test-provenance-0.3.16.jar"</argLine></configuration>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
