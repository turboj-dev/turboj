---
import TurboJDemo from './TurboJDemo.astro';
---
<section class="hero" id="overview" aria-labelledby="hero-heading">
  <div class="shell">
    <div class="hero-topline"><p class="eyebrow">TURBOJ / MACOS / IN DEVELOPMENT</p><span aria-hidden="true">2026</span></div>
    <h1 class="hero-title" id="hero-heading">Java, straight to the point.</h1>
