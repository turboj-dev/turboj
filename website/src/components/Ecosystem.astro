---
import { site } from '../data/site';
const projects = [
  {
    title: 'RefactorJ — Change Java with confidence.',
    description: 'Semantic refactoring and code actions with conflict checks, change previews, cross-file edits, and undo.',
    detail: '33 implemented refactoring operations and code actions. Applicability checks reject unsupported transformations; reflection and unknown external consumers remain limits of static analysis.',
    path: 'refactorj',
  },
  {
    title: 'CommandJ — Your keyboard. Your workflow.',
    description: 'Use familiar shortcuts or define your own. CommandJ provides a searchable command palette, customizable bindings, multi-key sequences, and conflict detection.',
    detail: 'Choose IntelliJ macOS, Eclipse macOS, VS Code macOS, or TurboJ Classic. New installations default to the IntelliJ macOS keymap. Existing installations retain their previous bindings.',
    path: 'commandj',
  },
];
---

<section class="section" id="ecosystem" aria-labelledby="ecosystem-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">Native inside TurboJ, standalone everywhere else.</p>
      <h2 class="section-heading" id="ecosystem-heading">Independent tools. One focused editor.</h2>
    </header>
    <div class="ecosystem-grid">
      {projects.map((project) => (
        <article>
          <h3>{project.title}</h3>
          <p class="body-copy">{project.description}</p>
          <p class="project-detail">{project.detail}</p>
          <a class="text-link" href={`${site.links.source}/tree/main/${project.path}`}>Explore {project.path === 'refactorj' ? 'RefactorJ' : 'CommandJ'} source and documentation</a>
        </article>
      ))}
    </div>
    <div class="ecosystem-note">
      <h3>FormatJ — One consistent Java style.</h3>
      <p class="body-copy">Format a document or selection, with optional formatting on save. The standalone CLI retains the <code>javafmt</code> command.</p>
      <p class="project-detail">The existing Java package remains <code>dev.javafmt</code>. The project rename and move to an independent sibling repository are still pending.</p>
    </div>
    <div class="ecosystem-note">
      <h3>TurboTest — Verify as you work.</h3>
      <p class="body-copy">Run the current test, a test class, or all tests. Rerun failures, inspect results and stack traces, or stop a running suite.</p>
      <p class="body-copy">Save your Java source and TurboJ can compile it, run the selected program, or execute JUnit tests automatically. Both options are independent and off by default.</p>
      <p class="project-detail"><strong>Auto Run on Save</strong> and <strong>Auto Test on Save</strong> are remembered across sessions and run only after a successful, current compilation. The separate Auto Test on Changes option remains available.</p>
    </div>
    <p class="body-copy ecosystem-note">These are reusable Java libraries embedded directly in TurboJ. RefactorJ also provides optional CLI, LSP and MCP adapters for other tools and coding agents. Source and local distributions exist; Maven Central and plugin marketplace publication is still pending.</p>
  </div>
</section>

<style>
  .ecosystem-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  article { border-top: 1px solid var(--page-border); padding-top: 28px; }
  h3 { font-size: 20px; line-height: 1.4; letter-spacing: -.035em; margin-bottom: 14px; }
  .text-link { color: var(--tj-ui-link); margin-top: 16px; }
  .project-detail { font-size: 15px; line-height: 1.65; margin-top: 16px; }
  .ecosystem-note { margin-top: 28px; max-width: 920px; }
  @media (max-width: 720px) { .ecosystem-grid { grid-template-columns: 1fr; } }
</style>
