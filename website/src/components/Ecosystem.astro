---
import { site } from '../data/site';
const projects = [
  {
    title: 'RefactorJ — Refactor with confidence.',
    description: 'Semantic Java refactoring with safe previews, cross-file changes, and intelligent code transformations.',
    path: 'refactorj',
  },
  {
    title: 'CommandJ — Your keyboard. Your workflow.',
    description: 'Use familiar IntelliJ, Eclipse, VS Code, or classic TurboJ shortcuts. Customize every command.',
    path: 'commandj',
  },
];
---

<section class="section" id="ecosystem" aria-labelledby="ecosystem-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">NATIVE INSIDE TURBOJ. STANDALONE EVERYWHERE ELSE.</p>
      <h2 class="section-heading" id="ecosystem-heading">Independent tools. One focused editor.</h2>
    </header>
    <div class="ecosystem-grid">
      {projects.map((project) => (
        <article>
          <h3>{project.title}</h3>
          <p class="body-copy">{project.description}</p>
          <a class="text-link" href={`${site.links.source}/tree/main/${project.path}`}>Explore {project.path === 'refactorj' ? 'RefactorJ' : 'CommandJ'} source and documentation</a>
        </article>
      ))}
    </div>
    <p class="body-copy ecosystem-note">Both engines are independent Java libraries embedded directly in TurboJ. Other developer tools can reuse their APIs; RefactorJ also provides optional CLI, LSP and MCP adapters for editors and coding agents. External IDE packages have separate build and installation instructions.</p>
    <p class="body-copy ecosystem-note">FormatJ keeps Java formatting consistent through the existing javafmt API. TurboTest runs JUnit tests from your current source, with optional automatic testing after an applied refactoring. Previews never execute your code.</p>
  </div>
</section>

<style>
  .ecosystem-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  article { border-top: 1px solid var(--page-border); padding-top: 28px; }
  h3 { font-size: 20px; line-height: 1.4; letter-spacing: -.035em; margin-bottom: 14px; }
  .text-link { color: var(--tj-ui-link); margin-top: 16px; }
  .ecosystem-note { margin-top: 28px; max-width: 920px; }
  @media (max-width: 720px) { .ecosystem-grid { grid-template-columns: 1fr; } }
</style>
