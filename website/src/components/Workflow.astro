---
import { workflow } from '../data/copy';
import { site } from '../data/site';
---

<section class="section workflow-section" id="workflow" aria-labelledby="workflow-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">THE WORKFLOW</p>
      <h2 class="section-heading" id="workflow-heading">Four steps. One window.</h2>
    </header>
    <ol class="workflow-steps" role="list">
      {workflow.map((step) => (
        <li class="workflow-step">
          <span class="section-index" aria-hidden="true">{step.number} /</span>
          <h3>{step.title}</h3>
          {step.paragraphs.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
        </li>
      ))}
    </ol>
    <a class="button button-secondary" href={site.links.demo}>Watch Hello World</a>
  </div>
</section>

<style>
  @media (min-width: 721px) {
    .workflow-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .workflow-step:nth-child(2)::after { content: '↓'; }
  }
  @media (min-width: 1100px) {
    .workflow-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .workflow-step:nth-child(2)::after { content: '→'; }
  }
</style>
