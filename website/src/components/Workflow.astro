---
import { workflow } from '../data/copy';
---

<section class="section workflow-section" id="workflow" aria-labelledby="workflow-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">THE WORKFLOW</p>
      <h2 class="section-heading" id="workflow-heading">Three steps. One window.</h2>
    </header>
    <ol class="workflow-steps" role="list">
      {workflow.map((step) => (
        <li class="workflow-step">
          <span class="section-index" aria-hidden="true">{step.number} /</span>
          <h3>{step.title}</h3>
          {step.paragraphs.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
        </li>
      ))}
    </ol>
    <p class="section-closing">Edit. Compile. Run. Repeat.</p>
  </div>
</section>
