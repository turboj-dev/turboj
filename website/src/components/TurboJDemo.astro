---
import ProductScreenshot from './ProductScreenshot.astro';
import { CHAPTER_TITLES } from '../scripts/demo-timeline';
import '../styles/turboj-demo.css';
---
<script is:inline>document.documentElement.classList.add('demo-js');</script>
<section class="turboj-demo" id="demo" data-turboj-demo aria-label="Recorded TurboJ development workflow" aria-describedby="demo-description">
  <p id="demo-description" class="sr-only">Five chapters reconstruct measured native sessions. Source and console regions can be scrolled with the keyboard. Complete sources, logs, captures, and measurements are available in session details. No Java executes in your browser.</p>
  <div class="demo-stage">
    <ProductScreenshot />
    <!-- The immutable Classic capture is for no-JS only. This surface uses the
         saved palette before the controller/evidence loads, including offline failures. -->
    <div class="demo-loading" data-demo-loading>
      <p data-demo-loading-text>Loading recorded session…</p>
      <a href="/demo-session/">Read the recorded session, sources, and logs.</a>
    </div>
    <div class="demo-screen" data-demo-screen hidden>
      <div class="demo-menu" data-demo-menu aria-hidden="true"></div>
      <div class="demo-workspace" data-demo-workspace>
        <div class="demo-explorer" data-demo-explorer hidden>
          <span class="demo-explorer-title" aria-hidden="true">Project</span>
          <pre data-demo-explorer-rows tabindex="0" role="region" aria-label="Recorded Maven project explorer; use arrow keys to scroll"></pre>
        </div>
      <div class="demo-editor">
        <div class="demo-file-border" aria-hidden="true"><strong data-demo-filename></strong></div>
        <div class="demo-code-viewport" tabindex="0" role="region" aria-label="Recorded source; use arrow keys to scroll">
          <pre class="demo-gutter" data-demo-lines aria-hidden="true"></pre>
          <div class="demo-code-body">
            <pre class="demo-source" data-demo-source></pre>
            <span class="demo-cursor" data-demo-cursor aria-hidden="true"></span>
          </div>
        </div>
      </div>
      </div>
      <div class="demo-console">
        <div class="demo-message-border" aria-hidden="true"><span>Output</span></div>
        <pre data-demo-output tabindex="0" role="region" aria-label="Recorded TurboJ console; use arrow keys to scroll"></pre>
        <div class="demo-console-command" data-demo-console-command hidden>
          <span aria-hidden="true">:</span><div class="demo-console-command-field"><span aria-hidden="true">[</span><pre data-demo-console-command-text tabindex="0" role="region" aria-label="Recorded TurboJ command line; use arrow keys to scroll"></pre><span aria-hidden="true">]</span></div>
          <span class="demo-console-command-hint" data-demo-console-command-hint></span>
        </div>
      </div>
      <div class="demo-statusbar" aria-hidden="true"><span data-demo-status></span><span data-demo-position></span></div>
    </div>
    <div class="demo-recorded-overlay" data-demo-overlay hidden></div>
    <div class="demo-external" data-demo-external hidden>
      <p>External curl — recorded command/output</p>
      <pre data-demo-external-output tabindex="0" role="region" aria-label="Recorded external curl command and output"></pre>
      <p>No request is sent from your browser.</p>
    </div>
  </div>
  <noscript><p class="demo-no-script">JavaScript is off. This is a screenshot of the actual native application. <a href="/demo-session/">Read the recorded session, sources, and logs.</a></p></noscript>
  <div class="demo-controls demo-primary" data-demo-controls hidden role="group" aria-label="Recorded story playback">
    <button type="button" data-demo-action="pause" aria-label="Play the recorded five-chapter story">Play</button>
    <p class="demo-prompt" data-demo-prompt role="img" aria-label="Browser replay. No Java runs here." title="Browser replay. No Java runs here.">
      <span aria-hidden="true">&gt; </span><span data-demo-prompt-text aria-hidden="true">Browser replay. No Java runs here.</span><span class="demo-prompt-cursor" data-demo-prompt-cursor aria-hidden="true">▌</span>
    </p>
  </div>
  <!-- Keep the full evidence and navigation UI for maintenance/audits, outside the public focus order. -->
  <div data-demo-secondary hidden>
    <p class="demo-action" data-demo-operation></p>
    <div class="demo-controls" role="group" aria-label="Replay controls">
      <button type="button" data-demo-action="replay">Replay <span aria-hidden="true">↻</span></button>
      <button type="button" data-demo-action="previous" aria-label="Previous chapter">Previous</button>
      <button type="button" data-demo-action="next" aria-label="Next chapter">Next</button>
      <button type="button" data-demo-action="skip">Skip to result</button>
      <button type="button" data-demo-action="story">Play full story</button>
    </div>
    <div class="demo-chapters" role="group" aria-label="Recorded chapters">
      {CHAPTER_TITLES.map((title, index) => <button type="button" data-demo-chapter={index} aria-pressed="false">{title}</button>)}
    </div>
    <div class="demo-current" data-demo-current hidden>
      <p class="demo-command" data-demo-command></p>
      <p class="demo-time" data-demo-time></p>
      <p class="demo-recorded-note" data-demo-surface-note hidden></p>
      <a class="demo-frame-link" data-demo-frame href="/demo-session/" target="_blank" rel="noopener">View this native capture <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <div class="demo-context">
      <label class="demo-checkpoints">Recorded checkpoint <select data-demo-checkpoint aria-label="Recorded checkpoint"></select></label>
      <a href="/demo-session/" data-demo-details>Open measurement details, full source and logs <span aria-hidden="true">↗</span></a>
    </div>
    <p class="demo-kind" data-demo-keymap></p>
  <progress class="demo-progress" data-demo-progress max="1" value="0" aria-label="Chapter replay progress" hidden></progress>
  <div class="demo-caption">
    <div><p>Recorded TurboJ sessions, reconstructed in the browser. No Java runs here. Typing and reading pauses shortened.</p><p>Times from each identified captured session. <span data-demo-cache hidden>Dependencies already cached.</span></p></div>
  </div>
  <p class="demo-load-status" data-demo-load-status role="status" hidden>Loading recorded session.</p>
  </div>
  <p class="sr-only" data-demo-announcement role="status" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import '../scripts/turboj-demo';
</script>
