---
import { aiCompletionFeature, features, javaIntelligenceFeatures } from '../data/copy';
import { site } from '../data/site';
---

<section class="section features-section" id="features" aria-labelledby="features-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">SMALL TOOL. SERIOUS ENGINEERING.</p>
      <h2 class="section-heading" id="features-heading">Everything you need. Nothing in your way.</h2>
    </header>
    <div class="feature-list">
      {features.map((feature) => (
        <article class="feature">
          <span class="feature-number" aria-hidden="true">{feature.number}</span>
          <div class="feature-copy">
            <h3>{feature.title}</h3>
            {feature.paragraphs.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
          </div>
        </article>
      ))}
    </div>
    <div class="semantic-feature-list">
      {javaIntelligenceFeatures.map((feature) => (
        <article class="semantic-feature">
          <h3>{feature.title}</h3>
          <p class="body-copy">{feature.description}</p>
        </article>
      ))}
    </div>
    <article class="semantic-feature ai-feature" aria-labelledby="ai-feature-heading">
      <div>
        <p class="eyebrow">{aiCompletionFeature.label}</p>
        <h3 id="ai-feature-heading">{aiCompletionFeature.title}</h3>
      </div>
      <div>
        <p class="body-copy">{aiCompletionFeature.description}</p>
        <p class="ai-status">{aiCompletionFeature.status}</p>
        <a class="text-link" href={site.links.aiDocs}>{aiCompletionFeature.linkLabel}</a>
      </div>
    </article>
  </div>
</section>

<style>
  .semantic-feature-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 8px; }
  .semantic-feature { border-top: 1px solid var(--page-border); padding-top: 28px; }
  .semantic-feature h3 { font-size: 19px; line-height: 1.4; letter-spacing: -.035em; margin-bottom: 14px; }
  .semantic-feature .body-copy { font-size: 17px; }
  .ai-feature { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; margin-top: 32px; }
  .ai-feature .eyebrow { color: var(--tj-ui-link); margin-bottom: 12px; }
  .ai-status { margin-top: 16px; font-size: 15px; line-height: 1.65; }
  .ai-feature .text-link { color: var(--tj-ui-link); margin-top: 8px; }
  @media (max-width: 1000px) {
    .semantic-feature-list { grid-template-columns: 1fr; gap: 28px; }
    .ai-feature { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 720px) {
    .semantic-feature { padding-top: 24px; }
    .semantic-feature h3 { font-size: 18px; }
    .semantic-feature .body-copy { font-size: 16px; }
  }
</style>
