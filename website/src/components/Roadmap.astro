---
import { site } from '../data/site';

const groups = [
  {
    title: 'AVAILABLE IN THE DEVELOPMENT PREVIEW',
    items: [
      'Native Java editing, compilation, execution, and JShell.',
      'Maven project support, including multi-module workspaces.',
      'Java intelligence, formatting, and semantic refactoring.',
      'JUnit testing and optional automation on save.',
      'Customizable keymaps, command palette, and themes.',
      'Optional local AI completion.',
    ],
  },
  {
    title: 'NEXT',
    items: [
      'Complete the javafmt-to-FormatJ project rename while retaining the javafmt CLI.',
      'Separate the ecosystem libraries into independent sibling projects and release workflows.',
      'Prepare independent artifact and IDE-plugin publication.',
      'Improve packaging, signing, notarization, and release verification.',
      'Continue performance and reliability validation.',
    ],
  },
  {
    title: 'NOT CURRENTLY DELIVERED',
    items: [
      'Integrated Java debugger.',
      'Gradle project import.',
      'Verified Intel, Windows, or Linux distribution.',
      'General marketplace/Maven Central publication of the independent tools.',
    ],
  },
];
---

<section class="section" id="roadmap" aria-labelledby="roadmap-heading">
  <div class="shell">
    <header class="section-header">
      <p class="eyebrow">DEVELOPMENT PRIORITIES</p>
      <h2 class="section-heading" id="roadmap-heading">Built today. Still moving forward.</h2>
      <p class="body-copy roadmap-introduction">TurboJ is under active development. These are the current priorities, not release promises.</p>
    </header>
    <div class="roadmap-grid">
      {groups.map((group) => (
        <article>
          <h3>{group.title}</h3>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <a class="text-link" href={`${site.links.source}/blob/main/TODO.md`}>Follow the repository TODO</a>
  </div>
</section>

<style>
  .roadmap-introduction { max-width: 800px; margin-top: 20px; }
  .roadmap-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  article { border-top: 1px solid var(--page-border); padding-top: 24px; }
  h3 { font: 500 13px/1.6 var(--mono); letter-spacing: .03em; }
  ul { margin: 18px 0 0; padding-left: 20px; }
  li { font-size: 16px; line-height: 1.65; margin-bottom: 10px; }
  li::marker { color: var(--tj-ui-link); }
  .text-link { color: var(--tj-ui-link); margin-top: 28px; }
  @media (max-width: 1000px) {
    .roadmap-grid { grid-template-columns: 1fr; gap: 24px; }
    ul { max-width: 680px; }
  }
</style>
