---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import EditorialSections from '../components/EditorialSections.astro';
import Features from '../components/Features.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Workflow from '../components/Workflow.astro';
import Performance from '../components/Performance.astro';
import FAQ from '../components/FAQ.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <section class="product-introduction" aria-label="The TurboJ workflow">
      <div class="shell">
        <p>This is the workflow TurboJ is built for: a source file, a compiler, and the result. Nothing else in the way.</p>
        <p class="introduction-tagline">Edit. Compile. Run. Repeat.</p>
      </div>
    </section>
    <Features />
    <Ecosystem />
    <Workflow />
    <Performance />
    <EditorialSections section="philosophy" />
    <EditorialSections section="status" />
    <FAQ />
  </main>
  <SiteFooter />
</BaseLayout>
