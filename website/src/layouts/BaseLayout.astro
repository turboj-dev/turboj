---
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/global.css';
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = new URL('/images/turboj-social.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0000aa" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.ogTitle} />
    <meta property="og:description" content={site.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TurboJ — The ultra-fast Java editor. The real editor running Hello World on macOS." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.ogTitle} />
    <meta name="twitter:description" content={site.ogDescription} />
    <meta name="twitter:image" content={social} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
